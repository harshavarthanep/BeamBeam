{
  "appId": "com.h24creationz.beambeam",
  "appName": "Beam Beam",
  "webDir": "www",
  "android": { "allowMixedContent": false, "captureInput": true, "webContentsDebuggingEnabled": false },
  "ios": { "contentInset": "never", "scrollEnabled": true },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 500, "launchAutoHide": true, "backgroundColor": "#2638E8", "showSpinner": false, "androidScaleType": "CENTER_CROP" },
    "StatusBar": { "overlaysWebView": false, "backgroundColor": "#2436E4", "style": "DARK" }
  }
}
