{
  "name": "Beam Beam — send big files directly",
  "short_name": "Beam Beam",
  "description": "Send files of any size straight to anyone with a link or QR code. No upload, no size limit, end-to-end encrypted, links that expire. Built by H24 Creationz.",
  "id": "./",
  "start_url": "./?app",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1B28B8",
  "theme_color": "#2638E8",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "./beambeam-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./beambeam-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./beambeam-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Send files", "url": "./?app", "icons": [{ "src": "./beambeam-icon-192.png", "sizes": "192x192" }] },
    { "name": "Receive files", "url": "./?app&receive", "icons": [{ "src": "./beambeam-icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "files", "accept": ["*/*"] }] }
  },
  "screenshots": [
    { "src": "./media/home.jpg", "sizes": "1600x1000", "type": "image/jpeg", "form_factor": "wide", "label": "Add files and get a link" },
    { "src": "./media/share.jpg", "sizes": "1600x1000", "type": "image/jpeg", "form_factor": "wide", "label": "Share by link, QR code or code, with a countdown" },
    { "src": "./media/m-home.jpg", "sizes": "780x1688", "type": "image/jpeg", "form_factor": "narrow", "label": "Beam Beam on a phone" },
    { "src": "./media/m-receive.jpg", "sizes": "780x1688", "type": "image/jpeg", "form_factor": "narrow", "label": "Receiving files directly" }
  ]
}
